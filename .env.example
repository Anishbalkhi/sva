# ==============================================================================
# svā labs — Environment Configuration Template
# Copy this file to .env.local for local testing or configure these in your host
# (Vercel / Netlify) under Project Settings → Environment Variables.
# ==============================================================================

# [Required for Production Waitlist] Supabase Storage
# Create a Supabase project and execute supabase/migrations/20261027000000_waitlist.sql
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# [Optional] Site Domain (Recommended for production canonical and OpenGraph tags)
NEXT_PUBLIC_SITE_URL=https://svalabs.in

# [Optional] Email Notifications on Waitlist Signup (SMTP or Resend)
# Option A: SMTP (e.g. Gmail App Password)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
WAITLIST_NOTIFY_TO=info@svalabs.in

# Option B: Resend HTTP API
# RESEND_API_KEY=re_123456789
# WAITLIST_NOTIFY_FROM="svā labs <waitlist@svalabs.in>"

# [Optional] Bot Protection via Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# [Optional] Distributed Rate Limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [Optional] Salt for hashing client IP addresses
RATE_LIMIT_SALT=sva-waitlist-secret-salt

